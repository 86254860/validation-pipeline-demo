# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go module files
COPY validation-pipeline-demo/validators/go.mod ./
COPY validation-pipeline-demo/validators/api-validator.go ./

# Build the binary explicitly for linux/amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o api-validator api-validator.go

# Runtime stage
FROM alpine:3.19

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/api-validator /app/api-validator

# Make it executable
RUN chmod +x /app/api-validator

# Set the entrypoint
ENTRYPOINT ["/app/api-validator"]
